num randPrecision = 100;

num radius = 3 + randomInt(randPrecision) / randPrecision * 2;
num warp = 1.5;
num warpFreq = 3;
num radiusSquared = pow(radius, 2);
num depth = 2 + randomInt(2);

// Don't place in air
if (getBlock(0, -1, 0) == "minecraft:air") fail;

for (num x = -radius - warp; x < radius + warp; x = x + 1) {
    for (num y = -depth; y < 1; y = y + 1) {
        for (num z = -radius - warp; z < radius + warp; z = z + 1) {
            num warpX = warp * sampler("simplex3",
                warpFreq * (x + originX()),
                warpFreq * (y + originY() + 1000),
                warpFreq * (z + originZ()));
            num warpZ = warp * sampler("simplex3",
                warpFreq * (x + originX()),
                warpFreq * (y + originY() + 3000),
                warpFreq * (z + originZ()));
            num dist = pow(x + warpX, 2) + pow(z + warpZ, 2);
            if (dist < radiusSquared) {
                if (y < 0) {
                    block(x, y, z, "minecraft:water", true, true);
                }
                if (y == 0) {
                    block(x, y, z, "minecraft:air", true);
                }
            }
        }
    }
}
