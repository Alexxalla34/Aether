num baseRadius = 5 + randomInt(3); 

for(num blob = 0; blob < 3; blob = blob + 1) {
    num offsetX = randomInt(baseRadius) - baseRadius/2;
    num offsetZ = randomInt(baseRadius) - baseRadius/2;
    num offsetY = randomInt(2) - 1;
    
    num rX = baseRadius * (0.8 + randomInt(40)/100);
    num rZ = baseRadius * (0.8 + randomInt(40)/100);
    num rY = 1.2 + randomInt(1);
    
    for (num x = -10; x <= 10; x = x + 1) {
        for (num y = -3; y <= 3; y = y + 1) {
            for (num z = -10; z <= 10; z = z + 1) {
                if (x >= -rX && x <= rX && y >= -rY && y <= rY && z >= -rZ && z <= rZ) {
                    num dist = (x*x) / (rX*rX) + (y*y) / (rY*rY) + (z*z) / (rZ*rZ);
                    if (dist <= 1) {
                        block(offsetX+x, offsetY+y, offsetZ+z, "minecraft:powder_snow", false);
                    }
                }
            }
        }
    }
}
