num baseRadius = 20 + randomInt(15); 

for(num blob = 0; blob < 15; blob = blob + 1) {
    num offsetX = randomInt(baseRadius*3) - baseRadius*1.5;
    num offsetZ = (randomInt(baseRadius*6) - baseRadius*3); 
    num offsetY = randomInt(5) - 2;
    
    num rX = baseRadius * (0.6 + randomInt(40)/100);
    num rZ = baseRadius * (2.0 + randomInt(100)/100); 
    num rY = 2 + randomInt(3);
    
    for (num x = -50; x <= 50; x = x + 1) {
        for (num y = -7; y <= 7; y = y + 1) {
            for (num z = -120; z <= 120; z = z + 1) {
                if (x >= -rX && x <= rX && y >= -rY && y <= rY && z >= -rZ && z <= rZ) {
                    num dist = (x*x) / (rX*rX) + (y*y) / (rY*rY) + (z*z) / (rZ*rZ);
                    if (dist <= 1) {
                        block(offsetX+x, offsetY+y, offsetZ+z, "minecraft:powder_snow", false);
                    }
                }
            }
        }
    }
}
